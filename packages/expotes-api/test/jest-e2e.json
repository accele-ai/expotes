{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": "test/.*\\.e2e-spec\\.ts$",
	"testTimeout": 60000,
	"maxWorkers": 1,
	"transform": {
		"^.+\\.ts$": [
			"ts-jest",
			{ "tsconfig": { "module": "CommonJS", "moduleResolution": "Node" } }
		]
	}
}
